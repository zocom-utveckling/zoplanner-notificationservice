# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# AWS SQS Configuration
AWS_SQS_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/your-account-id/zoplanner-notification-queue
AWS_SQS_POLLING_ENABLED=false

# AWS SES Configuration
AWS_SES_FROM_EMAIL=noreply@zoplanner.com
AWS_SES_FROM_NAME=ZoPlanner Notifications
AWS_SES_CONFIGURATION_SET=

# Database Configuration (defaults används i docker-compose.yml)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
